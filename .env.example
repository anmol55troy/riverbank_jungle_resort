# MongoDB connection string.
# Local dev: mongodb://127.0.0.1:27017/riverbank
# Vercel (or any serverless host): a MongoDB Atlas connection string, with network access
# opened to 0.0.0.0/0 (or the Vercel integration's IP list) since Vercel has no static egress IP.
DATABASE_URI=mongodb://127.0.0.1:27017/riverbank

# Secret used to sign administrative session tokens (generate a long random string for production, e.g. `openssl rand -hex 32`)
# Note: PAYLOAD_SECRET is also accepted as fallback for backwards compatibility
ADMIN_SESSION_SECRET=YOUR_SECRET_HERE

# Public URL of the site (no trailing slash). Used for canonical URLs, OG tags, sitemap.
# Baked in at build time — changing it requires a rebuild.
NEXT_PUBLIC_SERVER_URL=https://riverbankjungleresort.com.np

# Vercel Blob read/write token, used to store Media collection uploads (Vercel's filesystem
# is read-only/ephemeral, so local-disk uploads don't work there). Leave empty for local dev,
# where uploads fall back to the local `media/` directory.
# Create via: Vercel dashboard → Storage → Create Database → Blob, then Settings → Tokens
# (or `vercel blob store add`). Vercel auto-populates this env var for linked projects.
BLOB_READ_WRITE_TOKEN=

# Optional SMTP for emailing form submissions to the resort (leave empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_NOTIFY_EMAIL=info@riverbankjungleresort.com.np

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

