{
  "name": "river-bank-jungle-resort",
  "version": "1.0.0",
  "description": "River Bank Jungle Resort — Patihani, Chitwan. Next.js 15 custom admin & web application.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "seed": "tsx --env-file=.env src/seed/index.ts",
    "seed:blogs": "tsx --env-file=.env src/seed/add-blogs.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@lexical/list": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "cloudinary": "^2.11.0",
    "cross-env": "^7.0.3",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.0.0",
    "lexical": "^0.52.0",
    "mongoose": "^9.10.4",
    "next": "^15.5.0",
    "next-intl": "^4.0.0",
    "nodemailer": "^10.0.14",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "22.19.9",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.5",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  }
}
